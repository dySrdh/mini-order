generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id           String     @id @default(cuid())
  customerName String
  totalPrice   Float
  status       String     @default("Pending")
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model AuditLog {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String
  toStatus   String
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
}
